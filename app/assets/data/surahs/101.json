[{"id": 6158, "surah_id": 101, "ayah_number": 1, "page": 600, "juz": 30, "text_uthmani": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ ٱلۡقَارِعَةُ", "tafseer": "الساعة التي تقرع قلوب الناس بأهوالها."}, {"id": 6159, "surah_id": 101, "ayah_number": 2, "page": 600, "juz": 30, "text_uthmani": "مَا ٱلۡقَارِعَةُ", "tafseer": "أيُّ شيء هذه القارعة؟"}, {"id": 6160, "surah_id": 101, "ayah_number": 3, "page": 600, "juz": 30, "text_uthmani": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ", "tafseer": "وأيُّ شيء أعلمك بها؟"}, {"id": 6161, "surah_id": 101, "ayah_number": 4, "page": 600, "juz": 30, "text_uthmani": "یَوۡمَ یَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ", "tafseer": "في ذلك اليوم يكون الناس في كثرتهم وتفرقهم وحركتهم كالفراش المنتشر، وهو الذي يتساقط في النار."}, {"id": 6162, "surah_id": 101, "ayah_number": 5, "page": 600, "juz": 30, "text_uthmani": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ", "tafseer": "وتكون الجبال كالصوف متعدد الألوان الذي يُنْفَش باليد، فيصير هباء ويزول."}, {"id": 6163, "surah_id": 101, "ayah_number": 6, "page": 600, "juz": 30, "text_uthmani": "فَأَمَّا مَن ثَقُلَتۡ مَوَ ٰ⁠زِینُهُۥ", "tafseer": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."}, {"id": 6164, "surah_id": 101, "ayah_number": 7, "page": 600, "juz": 30, "text_uthmani": "فَهُوَ فِی عِیشَةࣲ رَّاضِیَةࣲ", "tafseer": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."}, {"id": 6165, "surah_id": 101, "ayah_number": 8, "page": 600, "juz": 30, "text_uthmani": "وَأَمَّا مَنۡ خَفَّتۡ مَوَ ٰ⁠زِینُهُۥ", "tafseer": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."}, {"id": 6166, "surah_id": 101, "ayah_number": 9, "page": 600, "juz": 30, "text_uthmani": "فَأُمُّهُۥ هَاوِیَةࣱ", "tafseer": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."}, {"id": 6167, "surah_id": 101, "ayah_number": 10, "page": 600, "juz": 30, "text_uthmani": "وَمَاۤ أَدۡرَىٰكَ مَا هِیَهۡ", "tafseer": "وما أدراك -أيها الرسول- ما هذه الهاوية؟"}, {"id": 6168, "surah_id": 101, "ayah_number": 11, "page": 600, "juz": 30, "text_uthmani": "نَارٌ حَامِیَةُۢ", "tafseer": "إنها نار قد حَمِيت من الوقود عليها."}]